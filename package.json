{
  "name": "rapidcam",
  "version": "1.6.0",
  "description": "Web-based parametric 2D vector editor — foundation for a CNC CAM program",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts cli mcp e2e",
    "format": "biome format --write src test scripts cli mcp e2e",
    "test": "vitest run",
    "cli": "tsx cli/rapidcam.ts",
    "mcp": "tsx mcp/server.ts",
    "test:e2e": "playwright test",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "validate:all": "npm run validate && npm run test:e2e",
    "clean": "node clean.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "clipper2-ts": "^2.0.1-17",
    "opentype.js": "^2.0.0",
    "posthog-js": "^1.383.2",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.28.0": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "^2.0.5"
    }
  }
}
